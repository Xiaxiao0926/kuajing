@@ -620,4 +620,66 @@ console.log('\n--- 12. 合法跨批次重复推流验证 (同 UID/来源/类目/
   console.log('  ✅ 12.1 合法跨批次重复推流验证通过：同一 candidateId，证据与最新 runId/排名平滑刷新')
