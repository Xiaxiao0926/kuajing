{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tariff.schema.json",
  "title": "WB 跨境物流费率版本",
  "type": "object",
  "required": ["tariff_id", "route_id", "route_name", "effective_from", "active", "tiers"],
  "properties": {
    "tariff_id": { "type": "string", "minLength": 1 },
    "route_id": { "type": "string", "minLength": 1 },
    "route_name": { "type": "string" },
    "warehouse_code": { "type": "string" },
    "origin_city": { "type": "string" },
    "destination_country": { "type": "string" },
    "service_level": { "type": "string", "enum": ["standard", "economy", "plus", "express"] },
    "eta_min_days": { "type": "integer", "minimum": 0 },
    "eta_max_days": { "type": "integer", "minimum": 0 },
    "weight_rounding_g": { "type": "integer", "minimum": 1 },
    "charge_basis": { "type": "string", "enum": ["actual_weight", "volumetric", "max"] },
    "max_weight_kg": { "type": "number", "exclusiveMinimum": 0 },
    "max_sum_dimensions_cm": { "type": "number", "exclusiveMinimum": 0 },
    "max_single_side_cm": { "type": "number", "exclusiveMinimum": 0 },
    "battery_limit_wh": { "type": ["number", "null"] },
    "reverse_to_ru_warehouse_included": { "type": "boolean" },
    "effective_from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "effective_to": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "active": { "type": "boolean" },
    "source_name": { "type": "string" },
    "notes": { "type": "string" },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["min_weight_kg", "max_weight_kg", "kg_rate_cny", "fixed_fee_cny"],
        "properties": {
          "min_weight_kg": { "type": "number", "minimum": 0 },
          "max_weight_kg": { "type": "number", "minimum": 0 },
          "kg_rate_cny": { "type": "number", "minimum": 0 },
          "fixed_fee_cny": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
