{
  "name": "ozon-kuajing",
  "version": "1.0.0",
  "description": "Ozon/WB 跨境电商运营工作区",
  "scripts": {
    "start": "node server.js",
    "dev": "node node_modules/nodemon/bin/nodemon.js server.js --watch server.js --watch analyze_with_cleaned_data.js --watch config.js --watch market_data_processor.js",
    "sync:config": "node scripts/sync-config.js",
    "test": "node scripts/sync-config.js && node --experimental-vm-modules ozon-react/src/utils/wbEngine.test.mjs && npm run test:scoring && npm run test:scoring-golden && npm run test:python",
    "test:scoring": "node --experimental-vm-modules ozon-react/src/utils/scoring/scoringEngine.test.mjs && node --experimental-vm-modules ozon-react/src/utils/scoring/monotonicity.test.mjs && node --experimental-vm-modules ozon-react/src/utils/scoring/scoringDataAdapter.test.mjs && node --experimental-vm-modules ozon-react/src/utils/scoring/scoringExport.test.mjs",
    "test:scoring-golden": "node scripts/run-scoring-golden.js",
    "test:python": "node scripts/run-wb-py-test.js",
    "test:golden": "node scripts/sync-config.js && node scripts/run-golden-tests.js",
    "test:sync": "node scripts/sync-config.js && node scripts/verify_sync.js",
    "test:web-persistence": "node tests/web-persistence.test.mjs && node tests/access-session.test.mjs"
  },
  "dependencies": {
    "csv-parser": "^3.2.1",
    "express": "^5.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "ngrok": "^5.0.0-beta.2",
    "nodemon": "^3.1.14"
  }
}
